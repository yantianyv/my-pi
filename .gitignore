# tsconfig.json 由 install.js 从 tsconfig.template.json 动态生成（paths 指向本机 pi 全局目录），不入库
tsconfig.json
node_modules/
# docs/ 是本地参考资料（DeepSeek 官方文档提取，版权归 DeepSeek），不入库
docs/
# dist/ 是构建产物（build.js 生成）：每次 install 自动重建，不入库
dist/

# test 临时构建产物（各扩展回归测试的 esbuild bundle/mock，每次测试重新生成）
src/extensions/*/test/.tmp-*
src/extensions/*/test/.dbg-*
src/extensions/test/.tmp-*
# 根目录手跑 esbuild 调试产物兜底（outfile 相对路径未带目录时落 CWD）
/.tmp-*

# 问卷运行时数据（ask 扩展的草稿/答案，随答随删，类似会话状态）
.pi/questionnaires/
.pi/sessions/
# pair-guard 临时排障日志（本机运行时数据）
.pi/pair-*.log
# 工作流会话绑定表（workflow-mgr：sessionId→槽，本机会话级运行时数据）
.pi/workflow/bindings.json

# explore 子代理的运行产物（渐进报告 + 单任务成果缓存）：与具体仓库内容无关，不入库
.pi/explore/
