# tsconfig.json 由 install.js 从 tsconfig.template.json 动态生成（paths 指向本机 pi 全局目录），不入库
tsconfig.json
node_modules/
# docs/ 是本地参考资料（DeepSeek 官方文档提取，版权归 DeepSeek），不入库
docs/
# dist/ 是构建产物（build.js 生成）：每次 install 自动重建，不入库
dist/

# test 临时构建产物（各扩展回归测试的 esbuild bundle/mock，每次测试重新生成）
src/extensions/*/test/.tmp-*
src/extensions/*/test/.dbg-*
